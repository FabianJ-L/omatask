pkgname=omatask
pkgver=0.1.0
pkgrel=1
pkgdesc='A task manager for Omarchy: processes, performance, sensors, startup and services'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'systemd' 'polkit')
optdepends=('nvidia-utils: utilization, memory and temperature of NVIDIA GPUs')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/omatask "$pkgdir/usr/bin/omatask"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/omatask.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/omatask.svg"
  install -Dm644 "$startdir/omatask.desktop" "$pkgdir/usr/share/applications/omatask.desktop"
}
